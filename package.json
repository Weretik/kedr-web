{
  "name": "kedr-web",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "prepare": "husky",
    "contracts:sync": "node tools/contracts/sync-kedr-api.mjs",
    "contracts:lint": "redocly lint docs/contracts/openapi/openapi.yaml --extends minimal",
    "contracts:generate": "openapi-typescript docs/contracts/openapi/openapi.yaml -o libs/shared/api-contracts/src/generated/kedr-api.ts",
    "contracts:check": "npm run contracts:lint && npm run contracts:generate && git diff --exit-code -- libs/shared/api-contracts/src/generated/kedr-api.ts",
    "tokens:gen": "node tools/tokens/generate-tailwind-palette.mjs",
    "storefront:start": "node dist/apps/storefront/server/server.mjs",
    "docs:check": "node tools/docs/check-markdown.mjs",
    "docs:format:check": "prettier --check \"docs/**/*.md\"",
    "security:audit": "node tools/security/check-npm-audit.mjs",
    "architecture:boundaries": "node tools/architecture/check-project-boundaries.mjs",
    "architecture:boundaries:fixtures": "node --test tools/architecture/check-project-boundaries.spec.mjs",
    "test:web": "npm run test:web:unit && npm run test:web:component",
    "test:web:unit": "nx run-many -t vite:test --parallel=1 --projects=admin-shared-api-client,admin-products-data-access,admin-clients-model,admin-clients-data-access,admin-orders-data-access,admin-users-model,admin-users-feature -- --run",
    "test:web:component": "nx run-many -t vite:test --parallel=1 --projects=admin,admin-core-auth,admin-core-shell,admin-products-feature,admin-clients-ui,admin-clients-feature,admin-orders-ui,admin-orders-feature,admin-users-ui -- --run",
    "test:web:coverage": "nx run-many -t vite:test --projects=admin,admin-shared-api-client -- --run --coverage",
    "test:web:e2e": "nx e2e admin-e2e",
    "test:storefront": "nx vite:test storefront-data-access --run",
    "test:site": "nx run-many -t vite:test --parallel=1 --projects=site-core-config,site-core-i18n,site-core-seo,site-core-shell,site-shared-ui,site-shared-api-client,site-catalog-model,site-catalog-data-access,site-catalog-ui,site-home-ui,site-home-seo,site-home-feature -- --run",
    "test:mobile": "nx run-many -t test --parallel=1 --projects=mobile,mobile-core-auth,mobile-cart-data-access,mobile-cart-feature,mobile-cart-model,mobile-cart-ui,mobile-catalog-data-access,mobile-core-connectivity,mobile-catalog-feature,mobile-catalog-model,mobile-shared-config,mobile-shared-model,mobile-catalog-ui,mobile-orders-model,mobile-orders-data-access,mobile-orders-ui,mobile-orders-feature,mobile-customers-model,mobile-customers-data-access,mobile-customers-ui,shell,api-client -- --runInBand",
    "test:mobile:coverage": "nx run-many -t test --parallel=1 --projects=mobile,mobile-core-auth,mobile-cart-data-access,mobile-cart-feature,mobile-cart-model,mobile-cart-ui,mobile-catalog-data-access,mobile-core-connectivity,mobile-catalog-feature,mobile-catalog-model,mobile-shared-config,mobile-shared-model,mobile-catalog-ui,mobile-orders-model,mobile-orders-data-access,mobile-orders-ui,mobile-orders-feature,mobile-customers-model,mobile-customers-data-access,mobile-customers-ui,shell,api-client -- --runInBand --coverage",
    "typecheck:tests:web": "node tools/testing/typecheck-tests.mjs web",
    "typecheck:tests:storefront": "node tools/testing/typecheck-tests.mjs storefront",
    "typecheck:tests:mobile": "node tools/testing/typecheck-tests.mjs mobile",
    "typecheck:tests:site": "node tools/testing/typecheck-tests.mjs site",
    "typecheck:tests:e2e": "tsc -p apps/admin-e2e/tsconfig.json --noEmit",
    "typecheck:tests": "npm run typecheck:tests:web && npm run typecheck:tests:storefront && npm run typecheck:tests:mobile && npm run typecheck:tests:site && npm run typecheck:tests:e2e"
  },
  "private": true,
  "workspaces": [
    "apps/*"
  ],
