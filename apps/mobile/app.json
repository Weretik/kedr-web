{
  "expo": {
    "name": "Кедр Менеджер",
    "slug": "mobile",
    "version": "2.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/d4dbe4f7-f294-4be1-9081-44aa05f48ab8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.classkedr.mobile",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3FA435",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.classkedr.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Дозвольте Кедр Менеджер вибрати фото для профілю.",
          "cameraPermission": "Дозвольте Кедр Менеджер зробити фото для профілю."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F3",
          "dark": {
            "backgroundColor": "#0F110F",
            "image": "./assets/images/splash-icon.png"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Дозвольте Кедр Менеджер відкриватися за Face ID."
        }
      ],
      "expo-screen-orientation",
      "expo-updates"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4dbe4f7-f294-4be1-9081-44aa05f48ab8"
      }
    }
  }
}
