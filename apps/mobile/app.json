{
  "expo": {
    "name": "KEDR Mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.classkedr.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Дозвольте Кедр Менеджер відкриватися за Face ID."
        }
      ],
      "expo-screen-orientation"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4dbe4f7-f294-4be1-9081-44aa05f48ab8"
      }
    }
  }
}
