{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.20.0"
    },
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "extends": "base"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "channel": "preview",
      "distribution": "internal",
      "extends": "base"
    },
    "simulator": {
      "channel": "development",
      "developmentClient": true,
      "extends": "base",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "channel": "production",
      "extends": "base"
    }
  },
  "submit": {
    "production": {}
  }
}
