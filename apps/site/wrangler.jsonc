{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Worker of the public Next.js site; the Angular storefront keeps its own Pages project until cutover.
  "name": "kedr-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Lets the Worker call itself (OpenNext cache revalidation); must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kedr-site",
    },
  ],
  // 'use cache' data and prerendered pages (open-next.config.ts); namespaces created in the dashboard 2026-11-05.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "f17685bc56eb4f04af695122291d0f91" }, // kedr-site-cache
    { "binding": "NEXT_TAG_CACHE_KV", "id": "b167f3ba3a4648e9b02f26ecdff453d3" }, // kedr-site-tags
  ],
  // next/image optimization through Cloudflare Images (free tier: 5000 unique transformations a month).
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  // Environment variables and secrets live in the Cloudflare dashboard; deploys must not wipe them.
  "keep_vars": true,
}
